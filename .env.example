# API key for Resend, the email service the contact form sends through.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Public base URL of the site, e.g. https://example.com
# NEXT_PUBLIC_ prefix means this value SHIPS TO THE BROWSER. Never put a secret behind it.
NEXT_PUBLIC_SITE_URL=
