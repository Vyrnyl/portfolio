# API key for Resend, the email service the contact form sends through.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox where contact form submissions are delivered.
#
# MUST be the address that owns the Resend account. With no verified custom
# domain, Resend delivers ONLY to the account owner's address and returns a 403
# for anything else — see the note at the top of src/lib/email.ts.
CONTACT_TO_EMAIL=

# NOTE: there is no SITE_URL variable. The site's origin lives in
# src/content/site.ts as `site.url` and reaches every consumer through
# SITE_ORIGIN in src/lib/seo.ts. A NEXT_PUBLIC_SITE_URL existed briefly and was
# removed on 2026-09-15 because nothing read it — changing it would have altered
# nothing while appearing to be the source of truth.
